+/*******************************************************************************
+ * @fn      rfTxBufFree
+ *
+ * @brief   下行缓冲（pRfBuf）剩余空间，随每个发往主机的包回告，供主机做流控。
+ *
+ *          从机下行只有 512B 缓冲，主机捎带速率若超过从机 UART 输出速率，
+ *          缓冲就会满并丢包。把余量放进 rfPackage_t 的 resv（原本恒为 0 的
+ *          保留字段），主机即可据此限速；不识别该字段的旧主机自然忽略，向后兼容。
+ *
+ * @return  剩余字节数（上限 DATA_LEN_MAX_TX；0 = 缓冲已满，请主机暂停捎带）
+ */
+__HIGH_CODE
+static uint8_t rfTxBufFree( void )
+{
+    uint32_t used;
+    uint32_t free_len;
+
+    PFIC_DisableAllIRQ();
+    used = pRfBuf->data_len;
+    PFIC_EnableAllIRQ();
+
+    free_len = pRfBuf->buf_len - used;
+    if( free_len > DATA_LEN_MAX_TX )
+    {
+        free_len = DATA_LEN_MAX_TX;
+    }
+    return (uint8_t)free_len;
+}
+
